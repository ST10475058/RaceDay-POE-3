@model List<RaceDay.Web.Models.DTOs.EventDto>
@{
    ViewData["Title"] = "Events";
}
<h2>Upcoming Events</h2>
<div class="row mt-3">
    @foreach (var e in Model.Where(x => x.EventDate >= DateTime.Today).OrderBy(x => x.EventDate))
    {
        <div class="col-md-4 mb-4">
            <div class="card card-event">
                @if (!string.IsNullOrEmpty(e.BannerUrl))
                {
                    <img src="@e.BannerUrl" class="card-img-top" style="height:160px;object-fit:cover;" />
                }
                <div class="card-body">
                    <h5>@e.EventName</h5>
                    <p class="text-muted small">@e.EventDate.ToString("dd MMM yyyy") | @e.Location</p>
                    <span class="badge bg-secondary">@e.EventType</span>
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@e.EventID" class="btn btn-sm btn-primary">View & Enrol</a>
                </div>
            </div>
        </div>
    }
</div>