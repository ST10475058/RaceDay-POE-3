@model RaceDay.Web.Models.ViewModels.EventFormViewModel
@{
    ViewData["Title"] = "Edit Event";
}
<h2>Edit Event</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="card p-4 mt-3">
    <input type="hidden" asp-for="EventID" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EventName" class="form-label">Event Name</label>
        <input asp-for="EventName" class="form-control" />
        <span asp-validation-for="EventName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="EventDate" class="form-label">Date</label>
            <input asp-for="EventDate" type="datetime-local" class="form-control" />
            <span asp-validation-for="EventDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Location" class="form-label">Location</label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Distance" class="form-label">Distance (km)</label>
            <input asp-for="Distance" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Distance" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EventType" class="form-label">Event Type</label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Replace Banner Image (optional)</label>
        <input asp-for="BannerImage" type="file" class="form-control" accept="image/*" />
        @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
        {
            <img src="@Model.ExistingBannerUrl" class="mt-2 rounded" style="max-height:120px;" />
        }
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Dashboard" class="btn btn-secondary">Cancel</a>
</form>

<hr />

<h4 class="mt-4">Categories</h4>
@if (Model.Categories.Any())
{
    <ul class="list-group mb-3">
        @foreach (var c in Model.Categories)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span><strong>@c.CategoryName</strong> — @c.Description</span>
            </li>
        }
    </ul>
}
else
{
    <p class="text-muted">No categories yet.</p>
}

<form asp-action="AddCategory" method="post" class="row g-2 align-items-end">
    <input type="hidden" name="eventId" value="@Model.EventID" />
    <div class="col-md-4">
        <label class="form-label">Category Name</label>
        <input name="categoryName" class="form-control" required />
    </div>
    <div class="col-md-5">
        <label class="form-label">Description</label>
        <input name="description" class="form-control" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-success w-100">+ Add Category</button>
    </div>
</form>