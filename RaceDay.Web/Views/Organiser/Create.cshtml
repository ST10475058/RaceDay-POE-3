@model RaceDay.Web.Models.ViewModels.EventFormViewModel
@{
    ViewData["Title"] = "Create Event";
}
<h2>Create Event</h2>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="card p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label>Name</label><input asp-for="EventName" class="form-control" /></div>
    <div class="mb-3"><label>Description</label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="row">
        <div class="col mb-3"><label>Date</label><input asp-for="EventDate" type="datetime-local" class="form-control" /></div>
        <div class="col mb-3"><label>Location</label><input asp-for="Location" class="form-control" /></div>
    </div>
    <div class="row">
        <div class="col mb-3"><label>Distance (km)</label><input asp-for="Distance" type="number" step="0.01" class="form-control" /></div>
        <div class="col mb-3">
            <label>Type</label>
            <select asp-for="EventType" class="form-select">
                <option>Run</option>
                <option>Walk</option>
                <option>Cycle</option>
            </select>
        </div>
    </div>
    <div class="mb-3"><label>Banner Image</label><input asp-for="BannerImage" type="file" class="form-control" accept="image/*" /></div>
    <button class="btn btn-primary">Save</button>
</form>